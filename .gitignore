node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Signature Android : ne doit JAMAIS entrer dans le depot.
# Un keystore publie est un keystore a remplacer, et remplacer une cle de
# signature veut dire que plus aucune mise a jour ne s'installe par-dessus
# l'application deja en place.
*.jks
*.keystore
key.properties

# Android : `flutter create` regenere tout le dossier a chaque build, mais ne
# remplace pas un fichier existant. On ne versionne donc que les fichiers qui
# portent une configuration indispensable aux rappels :
#   - AndroidManifest.xml : permissions et receivers ;
#   - build.gradle.kts    : desugaring et activation des regles R8 ;
#   - proguard-rules.pro  : regles Gson sans lesquelles zonedSchedule echoue.
android/*
!android/app/
android/app/*
!android/app/build.gradle.kts
!android/app/proguard-rules.pro
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
